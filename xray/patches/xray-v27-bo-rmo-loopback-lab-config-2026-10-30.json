{
  "log": {
    "loglevel": "warning"
  },
  "api": {
    "tag": "lab-api",
    "services": [
      "HandlerService",
      "RoutingService"
    ]
  },
  "inbounds": [
    {
      "tag": "lab-api-in",
      "listen": "127.0.0.1",
      "port": 18080,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      }
    },
    {
      "tag": "lab-socks",
      "listen": "127.0.0.1",
      "port": 18081,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "lab-a",
      "protocol": "freedom",
      "settings": {
        "redirect": "127.0.0.1:18101"
      }
    },
    {
      "tag": "lab-b",
      "protocol": "freedom",
      "settings": {
        "redirect": "127.0.0.1:18102"
      }
    },
    {
      "tag": "lab-blocked",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "balancers": [
      {
        "tag": "lab-balancer",
        "selector": [
          "lab-"
        ],
        "strategy": {
          "type": "random"
        },
        "fallbackTag": "lab-a"
      }
    ],
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "lab-api-in"
        ],
        "outboundTag": "lab-api"
      },
      {
        "type": "field",
        "inboundTag": [
          "lab-socks"
        ],
        "balancerTag": "lab-balancer"
      }
    ]
  }
}