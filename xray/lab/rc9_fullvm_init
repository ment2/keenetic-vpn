#!/bin/busybox sh
# Runs inside a disposable QEMU full-system guest only. All files are virtual.
# This is NOT an installed Keenetic boot hook.
export PATH=/bin
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
# Load only reviewed guest modules embedded from the matching Ubuntu kernel.
for module in /mods/*.ko; do
  [ -f "$module" ] || continue
  insmod "$module" || echo "RC9_VM: guest module load skipped $(basename "$module")"
done
mkdir -p /run /mnt/rescue /mnt/active
echo "RC9_VM: GUEST_KERNEL_BOOTED"
echo "RC9_VM: kernel $(uname -r) actual full-system guest, not user-mode QEMU"
/bin/rc7cgroup
CGROUP_EXIT=$?
if [ "$CGROUP_EXIT" -eq 77 ]; then
  echo "RC9_VM: CGROUP_V1_UNAVAILABLE_HARD_NO_GO"
elif [ "$CGROUP_EXIT" -ne 0 ]; then
  echo "RC9_VM: FAIL cgroup-v1 guest experiment returned $CGROUP_EXIT"
  poweroff -f
fi
if [ "$CGROUP_EXIT" -eq 0 ]; then
  /bin/rc8privdrop || { echo "RC9_VM: FAIL privileged descendant containment experiment"; poweroff -f; }
fi
# RC9 QEMU guest-only. This is the genuine downloaded pinned Xray binary,
# not a synthetic substitute, but no physical MIPS/Linux4.9 kernel claim.
echo "RC9_VM: REAL_GUEST_IP_TRANSPARENT_CAPABILITY_MATRIX_BEGIN"
/bin/rc9capwrap none socket || {
  echo "RC9_VM: FAIL no-cap TCP UDP IP_TRANSPARENT denial"; poweroff -f;
}
/bin/rc9capwrap raw socket || {
  echo "RC9_VM: FAIL CAP_NET_RAW exact TCP UDP IP_TRANSPARENT"; poweroff -f;
}
mkdir -p /tmp
chmod 1777 /tmp
/bin/xray version || { echo "RC9_VM: FAIL official Xray version"; poweroff -f; }
echo "RC9_VM: REAL_XRAY_26_2_6_START_WITH_CAP_NET_RAW_ONLY"
/bin/rc9capwrap raw xray > /run/rc9-xray.log 2>&1 &
XRAY_PID=$!
XRAY_TICKS="$(awk '{print $22}' "/proc/$XRAY_PID/stat" 2>/dev/null)"
if [ -z "$XRAY_TICKS" ]; then echo "RC9_VM: FAIL child identity missing"; poweroff -f; fi
READY=0
for i in $(seq 1 80); do
  if [ -r "/proc/$XRAY_PID/status" ] && grep -q ':3039 ' /proc/net/tcp; then
    READY=1; break
  fi
  if ! kill -0 "$XRAY_PID" 2>/dev/null; then break; fi
  sleep 0.1
done
if [ "$READY" != 1 ]; then
  echo "RC9_VM: FAIL Xray transparent inbound did not bind"
  cat /run/rc9-xray.log
  poweroff -f
fi
# Child remains unreaped while shell parent owns it; never target arbitrary PID.
if [ "$(awk '{print $22}' "/proc/$XRAY_PID/stat" 2>/dev/null)" != "$XRAY_TICKS" ]; then
  echo "RC9_VM: FAIL process start ticks changed"; poweroff -f
fi
grep -q '^CapEff:[[:space:]]*0000000000002000' "/proc/$XRAY_PID/status" ||
  { echo "RC9_VM: FAIL Xray inherited unexpected capabilities"; poweroff -f; }
grep -q '^NoNewPrivs:[[:space:]]*1' "/proc/$XRAY_PID/status" ||
  { echo "RC9_VM: FAIL Xray no_new_privs lost"; poweroff -f; }
echo "RC9_VM: ACTUAL_XRAY_TRANSPARENT_LISTENER_CAP_NET_RAW_ONLY_UID65534_PASS"
# Only parent shell's direct Xray child is signalled and reaped.
kill "$XRAY_PID"
wait "$XRAY_PID" || true
echo "RC9_VM: CHILD_XRAY_REAPED_PARENT_OWNED"
# A NEW parent owns another real Xray and crashes. A separate guardian-like
# observer checks pinned PID/start ticks and TCP listener absence. It sends
# NO signal to the orphan or any PID derived from journal data.
/bin/rc9owner || true
if [ ! -f /run/rc9-owned-identity ]; then
  echo "RC9_VM: FAIL owner crash identity receipt absent"; poweroff -f
fi
read -r CHILD_ID CHILD_TICKS OWNER_ID < /run/rc9-owned-identity
if [ -z "$CHILD_ID" ] || [ -z "$CHILD_TICKS" ]; then
  echo "RC9_VM: FAIL incomplete child identity"; poweroff -f
fi
OWNED_DRAINED=0
for n in $(seq 1 90); do
  if grep -q ':3039 ' /proc/net/tcp; then sleep 0.05; continue; fi
  if [ -e "/proc/$CHILD_ID/stat" ]; then
    CURRENT_TICKS="$(awk '{print $22}' "/proc/$CHILD_ID/stat" 2>/dev/null)"
    CHILD_STATE="$(awk '/^State:/ {print $2}' "/proc/$CHILD_ID/status" 2>/dev/null)"
    if [ "$CURRENT_TICKS" != "$CHILD_TICKS" ]; then
      echo "RC9_VM: FAIL orphan PID reuse or identity drift"; poweroff -f
    fi
    if [ "$CHILD_STATE" != Z ] && [ "$CHILD_STATE" != X ]; then sleep 0.05; continue; fi
  fi
  OWNED_DRAINED=1;break
done
if [ "$OWNED_DRAINED" -ne 1 ]; then
  echo "RC9_VM: FAIL owned real Xray survived parent death"; poweroff -f
fi
echo "RC9_VM: REAL_XRAY_PARENT_SIGKILL_PDEATHSIG_IDENTITY_AND_LISTENER_DRAIN_PASS"
echo "RC9_VM: LIMITATION no guardian CAS nor full legacy descendant proof in guest"
mount -t ext4 /dev/vda /mnt/rescue || { echo "RC9_VM: FAIL independent rescue image missing"; poweroff -f; }
mount -t ext4 /dev/vdb /mnt/active || { echo "RC9_VM: FAIL active image missing"; poweroff -f; }
cd /mnt/rescue || exit 1
sha256sum -c SHA256SUMS || { echo "RC9_VM: FAIL_CLOSED_CORRUPT_RESCUE_NO_RESTORATION"; sync; poweroff -f; }
echo "RC9_VM: EXACT_FIVE_RESCUE_ORIGINALS_VERIFIED"
STAGE=second
grep -q rc7_stage=first /proc/cmdline && STAGE=first
if [ "$STAGE" = second ]; then
  if [ -e /dev/vdc ]; then
    echo "RC9_VM: FAIL USB image still attached second boot"
    poweroff -f
  fi
  if ! grep -qx 'stage=2' /mnt/active/journal; then
    echo "RC9_VM: FAIL_CLOSED_CORRUPT_JOURNAL_NO_RESTORATION"
    poweroff -f
  fi
  echo "RC9_VM: PREVIOUS_TWO_FILES_AND_JOURNAL_SURVIVED_QEMU_SIGKILL"
fi
# No shell source outside the simulated independent rescue image.
for name in S97 S98 S99 watchdog wifi_rules; do
  cp "/mnt/rescue/originals/$name.sh" "/mnt/active/.$name.sh.tmp" || exit 1
  cmp "/mnt/rescue/originals/$name.sh" "/mnt/active/.$name.sh.tmp" || exit 1
  /bin/rc7fsync "/mnt/active/.$name.sh.tmp" /mnt/active || { echo "RC9_VM: FAIL before-rename fdatasync"; poweroff -f; }
  sync
  mv "/mnt/active/.$name.sh.tmp" "/mnt/active/$name.sh" || exit 1
  /bin/rc7fsync "/mnt/active/$name.sh" /mnt/active || { echo "RC9_VM: FAIL after-rename fdatasync"; poweroff -f; }
  sync
  case "$name" in
    S97) echo 'stage=1' > /mnt/active/journal ;;
    S98) echo 'stage=2' > /mnt/active/journal ;;
    S99) echo 'stage=3' > /mnt/active/journal ;;
    watchdog) echo 'stage=4' > /mnt/active/journal ;;
    wifi_rules) echo 'stage=5' > /mnt/active/journal ;;
  esac
  /bin/rc7fsync /mnt/active/journal /mnt/active || { echo "RC9_VM: FAIL journal fdatasync"; poweroff -f; }
  sync
  if [ "$STAGE" = first ] && [ "$name" = S98 ]; then
    echo "RC9_VM: POWER_CUT_POINT_AFTER_FSYNC_TWO_FILES"
    while :; do sleep 1; done
  fi
done
for name in S97 S98 S99 watchdog wifi_rules; do
  cmp "/mnt/rescue/originals/$name.sh" "/mnt/active/$name.sh" || { echo "RC9_VM: FAIL original mismatch $name"; poweroff -f; }
done
echo "RC9_VM: REBOOT_FULL_RESTORE_5_OF_5_PASS"
echo "RC9_VM: LIMITATION two virtual ext4 disks not physical Keenetic nonUSB media"
sync
poweroff -f
